{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
